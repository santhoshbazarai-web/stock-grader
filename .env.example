# Local development: copy to .env and fill in. Never commit .env.
# Production uses .env.production (see .env.production.example and docs/DEPLOY.md), where the
# broker redirect URIs are https://<DOMAIN>/api/brokers/{fyers,kite}/callback.

# Broker redirect URIs go through the local HTTPS proxy (Caddyfile.local, README "Local HTTPS"):
#   caddy run --config Caddyfile.local --adapter caddyfile
# stockgrader.localtest.me resolves to 127.0.0.1; trust Caddy's local root certificate once.

# Fyers API v3 (https://myapi.fyers.in) — register FYERS_REDIRECT_URI in the Fyers developer console
FYERS_APP_ID=
FYERS_SECRET=
FYERS_REDIRECT_URI=https://stockgrader.localtest.me:8443/api/brokers/fyers/callback

# Kite Connect (https://developers.kite.trade) — register KITE_REDIRECT_URI in the Kite developer console
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URI=https://stockgrader.localtest.me:8443/api/brokers/kite/callback

# Encrypts broker access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Hostnames below match the docker-compose services; use localhost when running outside Docker.
DATABASE_URL=postgresql+psycopg://stockgrader:stockgrader@db:5432/stockgrader
REDIS_URL=redis://redis:6379/0

# Web app URL the broker OAuth callbacks redirect back to: the address you use the app at.
# To use the app over local HTTPS too, set WEB_URL=https://stockgrader.localtest.me:8443 and
# SESSION_COOKIE_SECURE=true.
WEB_URL=http://localhost:3000

# Single-user login password
APP_PASSWORD=

# Optional: stock.indianapi.in key for bulk fundamentals (10+ years without NSE). Sent only
# as the X-Api-Key header; never logged. Empty = the source is skipped ("not configured").
INDIANAPI_KEY=

# Optional: send notifications (price alerts, results changes, broker reminders) to Telegram and
# run the read-only bot (/grade, /buyzone, /status), which answers only this chat id. Create a bot
# with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI thesis (SPEC §8a), default provider Google Gemini (jobs.yaml thesis.provider / model). Get a
# key at https://aistudio.google.com/apikey. Only the report's computed numbers and reasons are
# sent; the key is sent as a header and never logged. Empty = the thesis card asks for it.
GEMINI_API_KEY=

# Optional: use a local Ollama instead (set jobs.yaml thesis.provider: ollama, then
# `ollama pull llama3.1:8b`): nothing leaves your machine. "fake" = a development stand-in.
THESIS_LLM_URL=

# Optional (defaults shown): session lifetime, Secure cookie flag (enable behind HTTPS),
# login lockout after N failures per IP, Screener upload size limit.
# SESSION_TTL_HOURS=12
# SESSION_COOKIE_SECURE=false
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_S=900
# UPLOAD_MAX_BYTES=10485760
# Proxies allowed to report the client IP (X-Forwarded-For) for the login lockout, as a JSON
# list of IPs/CIDRs — e.g. the web container's Docker network. Only list addresses that cannot
# be reached directly from outside, or clients could spoof their IP.
# TRUSTED_PROXIES=["172.18.0.0/16"]
