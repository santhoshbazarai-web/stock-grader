# Production settings for docker-compose.prod.yml (see docs/DEPLOY.md).
#   cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production. Back it up somewhere safe: without FERNET_KEY the stored broker
# tokens cannot be decrypted (they expire daily anyway, so you would just reconnect).

# ── Domain and HTTPS ────────────────────────────────────────────────────────────────────────
# Public hostname. Its DNS A/AAAA record must point at this server; ports 80 and 443 open.
DOMAIN=grader.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=you@example.com
# Leave empty. "local_certs" makes Caddy use its internal CA (test box without public DNS).
CADDY_GLOBAL_OPTIONS=

# ── Secrets ─────────────────────────────────────────────────────────────────────────────────
# Single-user login password, at least 12 characters.
APP_PASSWORD=
# Encrypts broker access tokens at rest:
#   docker run --rm python:3.12-alpine sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
FERNET_KEY=
# Postgres password. Use URL-safe characters only (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=stockgrader
# POSTGRES_DB=stockgrader

# ── Brokers (read-only market data) ─────────────────────────────────────────────────────────
# Redirect URIs are derived from DOMAIN; register exactly these in the developer consoles:
#   Fyers: https://<DOMAIN>/api/brokers/fyers/callback
#   Kite:  https://<DOMAIN>/api/brokers/kite/callback
FYERS_APP_ID=
FYERS_SECRET=
KITE_API_KEY=
KITE_API_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────────────────────
# Telegram delivery of price alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM thesis (SPEC §8a; off until jobs.yaml thesis.enabled: true). A local Ollama
# server only (https://ollama.com, then `ollama pull llama3.1:8b`): the report's numbers never
# leave your machine and no paid API is used. On a server, run Ollama on the same host or private network.
THESIS_LLM_URL=
# API processes (uvicorn reads WEB_CONCURRENCY). 2 is plenty for one user.
WEB_CONCURRENCY=2
# LOG_LEVEL=INFO
# SESSION_TTL_HOURS=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_S=900
# UPLOAD_MAX_BYTES=10485760

# Backups: daily pg_dump at BACKUP_AT in BACKUP_TZ (a POSIX TZ string; IST = "IST-5:30").
# BACKUP_PATH=./backups
# BACKUP_AT=23:30
# BACKUP_TZ=IST-5:30
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHS=12

# Where the YAML config lives on the host (Settings → Config writes here; owned by uid 1000).
# CONFIG_PATH=./config
# Image tag for the locally built images.
# IMAGE_TAG=latest
# Change only if 172.30.0.0/24 clashes with another Docker network on the host.
# EDGE_SUBNET=172.30.0.0/24
# CADDY_IP=172.30.0.10
