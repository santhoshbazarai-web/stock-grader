# Home deployment settings for docker-compose.home.yml (SPEC §3.10; README "Home deployment").
#   cp .env.home.example .env.home      (never commit .env.home)
# Back this file up somewhere safe: without FERNET_KEY the stored broker tokens cannot be
# decrypted (they expire daily anyway, so you would just reconnect).

# ── Secrets ─────────────────────────────────────────────────────────────────────────────────
# Login password, at least 12 characters.
APP_PASSWORD=
# Encrypts broker tokens at rest. Generate one:
#   docker run --rm python:3.12-alpine sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
FERNET_KEY=
# Postgres password, URL-safe characters only (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Backups (another drive) ─────────────────────────────────────────────────────────────────
# Folder for the nightly pg_dump. Running docker compose from WSL: /mnt/d/stock-grader-backups
# (drive D:); from PowerShell: D:/stock-grader-backups. Create it first.
BACKUP_PATH=/mnt/d/stock-grader-backups
# BACKUP_AT=02:00            # daily, in BACKUP_TZ; missed while asleep → taken at start-up
# BACKUP_TZ=IST-5:30
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHS=12

# ── Address ─────────────────────────────────────────────────────────────────────────────────
# Where the app is opened. Default http://127.0.0.1:3000. To use it from your phone over
# Tailscale with HTTPS (`tailscale serve`), set your tailnet name and turn the cookie flag on:
# WEB_URL=https://<machine>.<tailnet>.ts.net
# SESSION_COOKIE_SECURE=true

# ── Brokers (read-only market data) ─────────────────────────────────────────────────────────
# Register these redirect URIs in the developer consoles (defaults shown; with Tailscale HTTPS
# use https://<machine>.<tailnet>.ts.net/api/brokers/<broker>/callback and set them here):
#   Fyers: http://127.0.0.1:8000/api/brokers/fyers/callback
#   Kite:  http://127.0.0.1:8000/api/brokers/kite/callback   (Kite is disabled in providers.yaml)
FYERS_APP_ID=
FYERS_SECRET=
# FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/brokers/fyers/callback
KITE_API_KEY=
KITE_API_SECRET=
# KITE_REDIRECT_URI=http://127.0.0.1:8000/api/brokers/kite/callback

# Optional: stock.indianapi.in key for bulk fundamentals (10+ years without NSE). Sent only
# as the X-Api-Key header; never logged. Empty = the source is skipped ("not configured").
INDIANAPI_KEY=

# ── Telegram (optional, outbound only) ──────────────────────────────────────────────────────
# Notifications + the read-only bot (/grade, /buyzone, /status), answering only this chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM thesis (SPEC §8a; off until jobs.yaml thesis.enabled: true). A local Ollama
# server only (https://ollama.com, then `ollama pull llama3.1:8b`): the report's numbers never
# leave your machine and no paid API is used. From the containers, Ollama on this machine is
# http://host.docker.internal:11434 (set OLLAMA_HOST=0.0.0.0 so it listens beyond localhost).
THESIS_LLM_URL=

# ── Optional ────────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# CONFIG_PATH=./config       # Settings → Config writes here (owned by uid 1000)
# HOME_SUBNET=172.31.0.0/24  # change both if this clashes with another Docker network
# WEB_IP=172.31.0.10
